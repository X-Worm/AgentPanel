# =============================================================================
# Template for local secrets. Copy this file to `.env` and fill in the values:
#   cp .env.example .env       (PowerShell: Copy-Item .env.example .env)
# `.env` is gitignored; this template is committed. Do NOT put real keys here.
# =============================================================================

# --- Claude (Anthropic) — required to run agents with Claude models ----------
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Voyage AI — required for the Knowledge Base (embeddings) -----------------
# Get a key at https://dashboard.voyageai.com/ -> API Keys
VOYAGE_API_KEY=pa-...

# --- Postgres (used by docker-compose) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Optional overrides (defaults live in appsettings.json) ------------------
# ASP.NET config keys use a double underscore (__) as the section separator.
# Llm__Provider=Anthropic
# Llm__DefaultModel=claude-opus-4-8
# ConnectionStrings__DefaultConnection=Host=localhost;Database=AgentControlPanel;Username=postgres;Password=postgres
