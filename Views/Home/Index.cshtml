@{
    ViewData["Title"] = "Dashboard";
}

<div class="px-4 py-8 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl bg-gradient-to-r from-brand-600 to-blue-600 bg-clip-text text-transparent pb-2">
            Agent Control Panel
        </h1>
        <p class="mt-4 text-xl text-gray-500">
            A centralized hub to manage your AI Agents, design Skills, configure vector Knowledge Bases, and orchestrate Model Context Protocol (MCP) integrations.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        
        <!-- Agents Card -->
        <div class="group relative bg-white flex flex-col justify-between rounded-2xl shadow-sm border border-gray-100 p-8 hover:shadow-xl hover:border-blue-200 hover:-translate-y-1 transition-all duration-300">
            <div>
                <div class="w-12 h-12 inline-flex items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Agents</h3>
                <p class="text-gray-500 mb-6">Create, control, and monitor your autonomous AI agents safely in one place.</p>
            </div>
            <a asp-controller="Agent" asp-action="Index" class="inline-flex mt-auto w-full items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-100 transition-colors">
                Manage Agents
            </a>
        </div>

        <!-- Skills Card -->
        <div class="group relative bg-white flex flex-col justify-between rounded-2xl shadow-sm border border-gray-100 p-8 hover:shadow-xl hover:border-brand-200 hover:-translate-y-1 transition-all duration-300">
            <div>
                <div class="w-12 h-12 inline-flex items-center justify-center rounded-xl bg-brand-50 text-brand-600 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Skills</h3>
                <p class="text-gray-500 mb-6">Define custom capabilities or generate entirely new AI skills via AWS Bedrock.</p>
            </div>
            <a asp-controller="Skill" asp-action="Index" class="inline-flex mt-auto w-full items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 focus:ring-4 focus:ring-brand-100 transition-colors">
                Manage Skills
            </a>
        </div>

        <!-- Knowledge Base Card -->
        <div class="group relative bg-white flex flex-col justify-between rounded-2xl shadow-sm border border-gray-100 p-8 hover:shadow-xl hover:border-green-200 hover:-translate-y-1 transition-all duration-300">
            <div>
                <div class="w-12 h-12 inline-flex items-center justify-center rounded-xl bg-green-50 text-green-600 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Knowledge</h3>
                <p class="text-gray-500 mb-6">Manage context via Qdrant vector storage and advanced RAG configuration.</p>
            </div>
            <a asp-controller="KnowledgeBase" asp-action="Index" class="inline-flex mt-auto w-full items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-100 transition-colors">
                Vector DB
            </a>
        </div>

        <!-- MCP Card -->
        <div class="group relative bg-white flex flex-col justify-between rounded-2xl shadow-sm border border-gray-100 p-8 hover:shadow-xl hover:border-purple-200 hover:-translate-y-1 transition-all duration-300">
            <div>
                <div class="w-12 h-12 inline-flex items-center justify-center rounded-xl bg-purple-50 text-purple-600 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">MCP Servers</h3>
                <p class="text-gray-500 mb-6">Set up and govern Model Context Protocol connections securely.</p>
            </div>
            <a asp-controller="MCP" asp-action="Index" class="inline-flex mt-auto w-full items-center justify-center px-4 py-2.5 text-sm font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-700 focus:ring-4 focus:ring-purple-100 transition-colors">
                Configure MCP
            </a>
        </div>
        
    </div>
</div>
