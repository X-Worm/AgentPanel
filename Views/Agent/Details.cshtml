@model AgentControlPanel.Models.Agent

@{
    ViewData["Title"] = "Agent Details";
}

<div class="px-4 py-8 max-w-7xl mx-auto">
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                @Model.Name
            </h2>
            <div class="mt-1 flex flex-col sm:mt-0 sm:flex-row sm:flex-wrap sm:space-x-6">
                <div class="mt-2 flex items-center text-sm text-gray-500">
                    <svg class="mr-1.5 h-5 w-5 flex-shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" />
                    </svg>
                    Created on @Model.CreatedAt.ToLocalTime().ToString("g")
                </div>
                <div class="mt-2 flex items-center text-sm text-gray-500">
                    <svg class="mr-1.5 h-5 w-5 flex-shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
                    </svg>
                    Model: @(string.IsNullOrWhiteSpace(Model.Model) ? "default" : Model.Model)
                </div>
                <div class="mt-2 flex items-center text-sm">
                    @if (Model.KnowledgeBaseEnabled)
                    {
                        <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">Knowledge base: enabled</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Knowledge base: off</span>
                    }
                </div>
            </div>
        </div>
        <div class="mt-4 flex md:ml-4 md:mt-0 gap-3">
            <a asp-action="Test" asp-route-id="@Model.Id" class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors">
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM8.94 6.94a.75.75 0 111.06 1.06L7.81 10l2.19 2.19a.75.75 0 11-1.06 1.06l-2.72-2.72a.75.75 0 010-1.06l2.72-2.72zM13 10.75a.75.75 0 01.75-.75h.01a.75.75 0 010 1.5H13.75a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
                </svg>
                Test Agent
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors">
                Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-600 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-red-50 transition-colors">
                Delete
            </a>
            <a asp-action="Index" class="inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors">
                Back to List
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
            <!-- System Prompt Section -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 flex items-center justify-between">
                    <h3 class="text-base font-semibold leading-6 text-gray-900">System Prompt</h3>
                    <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Core Identity</span>
                </div>
                <div class="p-6">
                    @if (string.IsNullOrWhiteSpace(Model.SystemPrompt))
                    {
                        <div class="text-center py-6">
                            <p class="text-sm text-gray-500 italic">No system prompt has been defined for this agent.</p>
                        </div>
                    }
                    else
                    {
                        <pre class="whitespace-pre-wrap break-words text-sm text-gray-800 font-mono bg-gray-50 p-4 rounded-lg border border-gray-200">@Model.SystemPrompt</pre>
                    }
                </div>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
                    <h3 class="text-base font-semibold leading-6 text-gray-900">Description</h3>
                </div>
                <div class="p-6">
                    <p class="text-sm text-gray-700 leading-relaxed">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                    </p>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1 space-y-8">
            <!-- Skills section -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 flex items-center justify-between">
                    <h3 class="text-base font-semibold leading-6 text-gray-900">Assigned Skills</h3>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">
                        @(Model.Skills?.Count ?? 0)
                    </span>
                </div>
                <div class="divide-y divide-gray-200">
                    @if (Model.Skills == null || !Model.Skills.Any())
                    {
                        <div class="px-6 py-5 text-center sm:px-6">
                            <p class="text-sm text-gray-500">No skills assigned to this agent.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var skill in Model.Skills)
                        {
                            <div class="px-6 py-4 flex items-center">
                                <span class="bg-indigo-100 text-indigo-800 p-1.5 rounded-md mr-3 flex-shrink-0">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                    </svg>
                                </span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">
                                        @skill.Name
                                    </p>
                                    @if(skill.IsAIGenerated) {
                                        <p class="text-xs text-gray-500">AI Generated</p>
                                    }
                                </div>
                                <a asp-controller="Skill" asp-action="Details" asp-route-id="@skill.Id" class="text-xs font-medium text-blue-600 hover:text-blue-500 flex-shrink-0 ml-2">
                                    View
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
